<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Warna Background Badge Level -->
    <solid android:color="#1E3A5F" /> 
    
    <!-- Membuat sudut membulat sempurna (bentuk Pill/Oval) -->
    <corners android:radius="50dp" />
    
    <!-- Padding internal agar teks tidak mepet ke pinggir -->
    <padding 
        android:left="8dp" 
        android:right="8dp" 
        android:top="2dp" 
        android:bottom="2dp" />
        
</shape>