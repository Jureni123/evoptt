<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical|center_horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="12dp"
    android:background="#CC000000">

    <!-- 1. TOMBOL KIRI: Audio Menu (Dikecilkan) -->
    <LinearLayout
        android:id="@+id/btn_audio_menu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_action_audio" 
            app:tint="#FFFFFF" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Spacer Kiri agar PTT benar-benar tengah -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 2. TOMBOL TENGAH: PTT Container (Lebar Diperkecil, Tinggi Ditambah) -->
    <FrameLayout
        android:id="@+id/ptt_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="120dp"
        android:minHeight="56dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="center"
        android:background="@drawable/bg_ptt_button_transparent" 
        android:clickable="true"
        android:focusable="true">
        
        <!-- mTalkButton akan di-inject ke sini oleh Java Code -->
        
    </FrameLayout>

    <!-- Spacer Kanan agar PTT benar-benar tengah -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 3. TOMBOL KANAN: Session Menu (Dikecilkan) -->
    <LinearLayout
        android:id="@+id/btn_session_menu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_stat_notify"
            app:tint="#FFFFFF" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menu"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</LinearLayout>