<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp"
    android:background="#121212">

    <!-- 1. AUDIO MENU (Kiri) -->
    <LinearLayout android:id="@+id/btn_audio_menu"
        android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center"
        android:background="?selectableItemBackgroundBorderless">
        <ImageView android:src="@drawable/ic_action_audio" 
            android:layout_width="24dp" android:layout_height="24dp"
            android:tint="#FFFFFF"/>
        <TextView android:text="Audio" android:textSize="10sp" 
            android:textColor="#AAAAAA" android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- 2. SESSION MENU (Kanan) -->
    <LinearLayout android:id="@+id/btn_session_menu"
        android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center"
        android:background="?selectableItemBackgroundBorderless">
        <ImageView android:src="@drawable/ic_more_vert_black_24dp" 
            android:layout_width="24dp" android:layout_height="24dp"
            android:tint="#FFFFFF"/>
        <TextView android:text="Menu" android:textSize="10sp" 
            android:textColor="#AAAAAA" android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- 3. PTT BUTTON (TENGAH - BULAT BESAR) -->
    <FrameLayout android:id="@+id/ptt_container"
        android:layout_width="0dp" android:layout_weight="2"
        android:layout_height="wrap_content"
        android:gravity="center">
        
        <Button android:id="@+id/pushtotalk"
            android:layout_width="72dp" android:layout_height="72dp"
            android:background="@drawable/bg_ptt_circle"
            android:text="" 
            android:elevation="4dp"/>
            
    </FrameLayout>

</LinearLayout>