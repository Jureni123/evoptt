<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Klik/Pilih Animasi"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#0D47A1"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="4">

        <!-- CLAP: Pakai GIF Asli -->
        <ImageButton
            android:id="@+id/btn_gif_clap"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:src="@drawable/ton_clap"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="Tepuk Tangan"/>

        <!-- HEART: Pakai Placeholder Pink -->
        <ImageButton
            android:id="@+id/btn_gif_heart"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:src="@drawable/ic_heart_placeholder" 
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="Hati"/>

        <!-- FIRE: Pakai Placeholder Oranye -->
        <ImageButton
            android:id="@+id/btn_gif_fire"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:src="@drawable/ic_fire_placeholder"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="Api"/>

        <!-- LAUGH: Pakai Placeholder Kuning -->
        <ImageButton
            android:id="@+id/btn_gif_laugh"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:src="@drawable/ic_laugh_placeholder"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:contentDescription="Ngakak"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Semua Penguna Menerima Colekan Anda"
        android:textSize="12sp"
        android:textColor="#90CAF9"
        android:gravity="center"
        android:layout_marginTop="20dp"/>
</LinearLayout>