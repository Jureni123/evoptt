<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:foreground="?selectableItemBackground"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#121212"> <!-- True Black / Dark Gray untuk OLED -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 1. AREA LOGO / COVER ART BESAR (Seperti Album Art) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_server_placeholder"> <!-- Lihat instruksi di bawah untuk file ini -->
            
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_server_light"
                app:tint="#8AB4F8" /> <!-- Google Blue agar pop-up di OLED -->
        </FrameLayout>

        <!-- 2. NAMA SERVER (Judul Besar, Tengah) -->
        <TextView
            android:id="@+id/server_row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <!-- 3. STATUS (Online/Offline) - Repurpose dari version_status -->
        <TextView
            android:id="@+id/server_row_version_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:drawablePadding="6dp"
            android:fontFamily="sans-serif"
            android:text="● Online"
            android:textColor="#81C995" <!-- Google Green -->
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- ======================================================= -->
        <!-- AREA PRIVASI: ID TETAP ADA, TAPI DISEMBUNYIKAN (GONE)   -->
        <!-- Adapter tetap bisa inject data, tapi user tidak lihat   -->
        <!-- ======================================================= -->
        <TextView
            android:id="@+id/server_row_address"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/server_row_usercount"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/server_row_user"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/server_row_latency"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- 4. PROGRESS BAR KEREN (Gaya Google Play Store) -->
        <ProgressBar
            android:id="@+id/server_row_ping_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="8dp"
            android:progressDrawable="@drawable/progress_playstore_style"
            android:indeterminate="true"
            android:visibility="invisible" /> <!-- Tetap invisible, akan di-trigger adapter saat ping -->

        <!-- 5. TOMBOL OVERFLOW (Edit/Delete) di Pojok Kanan Atas -->
        <ImageView
            android:id="@+id/server_row_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginTop="-220dp" <!-- Menariknya ke atas menumpuk di area cover -->
            android:background="?selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_card_overflow"
            app:tint="#B0B0B0" />

    </LinearLayout>
</androidx.cardview.widget.CardView>