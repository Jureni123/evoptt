<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:orientation="vertical" android:padding="32dp">
    <TextView android:id="@+id/tv_title" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Izin Diperlukan"
        android:textSize="24sp" android:textStyle="bold" android:layout_marginBottom="16dp"/>
    <TextView android:id="@+id/tv_desc" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textAlignment="center"
        android:textSize="16sp" android:layout_marginBottom="32dp"/>
    <Button android:id="@+id/btn_grant" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Berikan Izin"
        android:textAllCaps="false"/>
</LinearLayout>
