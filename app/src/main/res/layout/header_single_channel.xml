<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    android:background="#121212">

    <!-- ID Channel (Kecil di atas) -->
    <TextView
        android:id="@+id/tv_channel_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CH 002"
        android:textColor="#888888"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <!-- Nama Channel (Besar & Jelas) -->
    <TextView
        android:id="@+id/tv_channel_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CHANNEL UMUM"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="4dp"/>

    <!-- Subtitle / Deskripsi -->
    <TextView
        android:id="@+id/tv_channel_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello Live"
        android:textColor="#AAAAAA"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="4dp"/>

    <!-- Status Bar Teknis (Online | BW | Latensi) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center">

        <TextView
            android:id="@+id/tv_user_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Online: 1"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  |  "
            android:textColor="#555555" />

        <TextView
            android:id="@+id/tv_bandwidth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↑: 0 kb ↓: 0 kb"
            android:textColor="#888888"
            android:textSize="14sp" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  |  "
            android:textColor="#555555" />

        <TextView
            android:id="@+id/tv_latency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Latensi: 42ms"
            android:textColor="#888888"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>