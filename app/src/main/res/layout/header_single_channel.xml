<?xml version="1.0" encoding="utf-8"?>
<!-- ROOT FRAMELAYOUT: Agar bisa stacking/overlay -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#121212"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <!-- CONTAINER UTAMA VERTIKAL (Hanya untuk elemen statis) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- BARIS 1: ID + NAMA CHANNEL (Horizontal biar hemat tinggi) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView
                android:id="@+id/tv_channel_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CH 1"
                android:textColor="#66FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"/>
                
            <TextView
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:background="#66FFFFFF"
                android:layout_marginHorizontal="6dp"/> 

            <TextView
                android:id="@+id/tv_channel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00.PERTAMA"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- AVATAR BESAR (Ukuran Compact 90dp) -->
        <ImageView
            android:id="@+id/img_main_avatar"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="6dp"
            android:src="@drawable/ic_launcher_foreground"
            android:scaleType="centerInside"
            android:background="@drawable/bg_circle_avatar"/>

        <!-- DESKRIPSI (Kecil & Ringkas) -->
        <TextView
            android:id="@+id/tv_channel_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deskripsi channel..."
            android:textColor="#888888"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end"/>

        <!-- ✅ ANNOUNCEMENT OVERLAY BOARD -->
        <TextView
            android:id="@+id/tv_announcement_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:textColor="#FFD700"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone"
            android:layout_marginTop="6dp"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"/>

        <!-- ✅ SMART ADMIN INPUT (SENIOR FRIENDLY - PUTIH CERAH) -->
        <!-- Muncul otomatis hanya untuk user yang punya permission Admin -->
        <LinearLayout
            android:id="@+id/admin_input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:elevation="4dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/et_admin_announce"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Ketik pengumuman..."
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@android:color/transparent"
                android:maxLines="1"
                android:inputType="text"/>

            <ImageButton
                android:id="@+id/btn_send_announce"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_action_send"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#000000"
                android:contentDescription="Kirim Pengumuman"/>
        </LinearLayout>
            
    </LinearLayout>

    <!-- NAMA SPEAKER ON-AIR (RELATIVE OVERLAY - TIDAK MENDORONG!) -->
    <TextView
        android:id="@+id/tv_speaker_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Armanto"
        android:textColor="#4CAF50"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_gravity="center" 
        android:visibility="gone"
        android:shadowColor="#000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"/>

</FrameLayout>