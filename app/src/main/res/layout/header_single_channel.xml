<?xml version="1.0" encoding="utf-8"?>
<!-- ROOT FRAMELAYOUT: Light Mode Premium -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F5F7FA" 
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <!-- CONTAINER UTAMA VERTIKAL (Hanya untuk elemen statis) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- BARIS 1: ID + NAMA CHANNEL (Horizontal biar hemat tinggi) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView
                android:id="@+id/tv_channel_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CH 1"
                android:textColor="#78909C" 
                android:textSize="12sp"
                android:textStyle="bold"/>
                
            <TextView
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:background="#B0BEC5"
                android:layout_marginHorizontal="8dp"/> 

            <TextView
                android:id="@+id/tv_channel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00.PERTAMA"
                android:textColor="#1A1A1A" 
                android:textSize="18sp" 
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- AVATAR BESAR (Dengan Border Halus) -->
        <ImageView
            android:id="@+id/img_main_avatar"
            android:layout_width="96dp" 
            android:layout_height="96dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/ic_launcher_foreground"
            android:scaleType="centerInside"
            android:background="@drawable/bg_circle_avatar_light"/> 

        <!-- DESKRIPSI (Kecil & Ringkas) -->
        <TextView
            android:id="@+id/tv_channel_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deskripsi channel..."
            android:textColor="#546E7A" 
            android:textSize="13sp"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:ellipsize="end"/>

        <!-- ✅ ANNOUNCEMENT OVERLAY BOARD (WARNA BARU: BIRU MUDA LEMBUT) -->
        <TextView
            android:id="@+id/tv_announcement_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E3F2FD" 
            android:textColor="#0D47A1" 
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone"
            android:layout_marginTop="12dp"
            android:elevation="2dp"/>

        <!-- ✅ SMART ADMIN INPUT (PUTIH BERSIH DENGAN BORDER) -->
        <LinearLayout
            android:id="@+id/admin_input_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:padding="10dp"
            android:layout_marginTop="12dp"
            android:elevation="4dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/et_admin_announce"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Ketik pengumuman..."
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@android:color/transparent"
                android:maxLines="1"
                android:inputType="text"/>

            <ImageButton
                android:id="@+id/btn_send_announce"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_action_send"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#0056B3" 
                android:contentDescription="Kirim Pengumuman"/>
        </LinearLayout>
            
    </LinearLayout>

    <!-- NAMA SPEAKER ON-AIR (RELATIVE OVERLAY - TIDAK MENDORONG!) -->
    <TextView
        android:id="@+id/tv_speaker_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Armanto"
        android:textColor="#00897B" 
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_gravity="center" 
        android:visibility="gone"
        android:elevation="4dp"/>

    <!-- ✅ TOMBOL EDIT INFO CHANNEL (POJOK KANAN ATAS - HANYA ADMIN) -->
    <ImageButton
        android:id="@+id/btn_edit_channel_info"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end" 
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_edit_note" 
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="#0056B3" 
        android:contentDescription="Edit Informasi Channel"
        android:visibility="gone" 
        android:elevation="4dp"/>

</FrameLayout>