<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:backgroundColor="#EEEEEE">

    <!-- 1. ID CHANNEL (Paling Atas Tengah) -->
    <TextView
        android:id="@+id/tv_channel_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CH 005"
        android:textColor="#00BFFF"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <!-- 2. NAMA CHANNEL (Tengah) -->
    <TextView
        android:id="@+id/tv_channel_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RADIO HELLO"
        android:textColor="#00FF41"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="4dp"/>

    <!-- 3. NAMA USER TRANSMIT (Dinamis - Placeholder di XML) -->
    <TextView
        android:id="@+id/tv_speaker_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="" 
        android:textColor="#4CAF50"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:visibility="gone"/> 

    <!-- 4. AVATAR BESAR (Dinamis: User vs Logo) -->
    <ImageView
        android:id="@+id/img_main_avatar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_launcher_foreground" 
        android:scaleType="centerInside"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_circle_avatar"/> 

    <!-- PLACEHOLDER FITUR TAMBAHAN (KB/PING/MENU - BELUM DI JAVA) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:visibility="gone"> 
        
        <TextView android:id="@+id/tv_user_count_placeholder" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Online: 0" android:textColor="#4CAF50"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" | " android:textColor="#555"/>
        <TextView android:id="@+id/tv_bw_placeholder" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↑:0kb ↓:0kb" android:textColor="#888"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" | " android:textColor="#555"/>
        <TextView android:id="@+id/tv_ping_placeholder" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ping: 0ms" android:textColor="#888"/>
    </LinearLayout>

    <!-- 5. DESKRIPSI CHANNEL (Paling Bawah Header) -->
    <TextView
        android:id="@+id/tv_channel_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selamat datang di channel ini!"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:layout_marginTop="12dp"/>

</LinearLayout>
