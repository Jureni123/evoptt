<?xml version="1.0" encoding="utf-8"?>
<!-- ROOT FRAMELAYOUT: Agar bisa stacking overlay -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#121212"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <!-- LAYER DASAR: Info Channel & Avatar Default (Selalu Ada) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Baris ID + Nama Channel -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView android:id="@+id/tv_channel_id" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CH 1" android:textColor="#66FFFFFF" android:textSize="11sp" android:textStyle="bold"/>
            <TextView android:layout_width="4dp" android:layout_height="4dp" android:background="#66FFFFFF" android:layout_marginHorizontal="6dp"/>
            <TextView android:id="@+id/tv_channel_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ROOT CHANNEL" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>

        <!-- SLOT SPEAKER TRANSPARAN (SELALU ADA, TINGGI TETAP!) -->
        <!-- Ini adalah "kolom transparan" yang kamu maksud. 
             Saat hening, isinya invisible tapi ruangnya tetap ada. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="60dp" 
            android:layout_marginTop="4dp">
            
            <!-- Avatar Besar Default (Channel Logo) -->
            <ImageView
                android:id="@+id/img_main_avatar"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_launcher_foreground"
                android:scaleType="centerInside"
                android:background="@drawable/bg_circle_avatar"/>

            <!-- NAMA SPEAKER OVERLAY (Posisi Absolut di Tengah Slot) -->
            <TextView
                android:id="@+id/tv_speaker_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="-10dp" 
                android:text=""
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:visibility="invisible"/> 
        </FrameLayout>

        <!-- Deskripsi Channel -->
        <TextView android:id="@+id/tv_channel_desc" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Deskripsi..." android:textColor="#888888" android:textSize="11sp" android:gravity="center" android:paddingHorizontal="24dp" android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end"/>
    </LinearLayout>

</FrameLayout>