<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Sapaan Atas -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Selamat Datang"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="italic" />

    <!-- Nama Aplikasi (Spacing dihapus agar tidak berantakan) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="48dp"
        android:text="MUMLA OLED"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Area Kosong di Tengah (Pendorong ke atas dan bawah) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- KOLOM ISI NAMA (Wajib ada agar user bisa ketik nama) -->
    <EditText
        android:id="@+id/et_nama_panggilan"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:background="#1A1A1A"
        android:hint="Ketik Nama Panggilan Kamu"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:textSize="16sp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:inputType="textPersonName"
        android:gravity="center_vertical" />

    <!-- Tombol SIMPAN (ID dan Teks sudah disesuaikan dengan kode Java kita) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_simpan"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="SIMPAN"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="#FFC107"
        app:cornerRadius="30dp"
        android:layout_marginBottom="16dp" />

    <!-- Tombol Logout Kecil (Opsional) -->
    <TextView
        android:id="@+id/tv_logout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ganti Nama / Logout"
        android:textColor="#666666"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <!-- Footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="© Mumla OLED 2026"
        android:textColor="#444444"
        android:textSize="12sp" />

</LinearLayout>