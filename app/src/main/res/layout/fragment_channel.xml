<!-- CONTAINER SINGLE CH VIEW (STRUKTUR VERTIKAL RAPI) -->
<FrameLayout
    android:id="@+id/single_ch_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone" 
    android:background="#FF121212"> 
    
    <!-- WRAPPER VERTIKAL: HEADER DI ATAS, LIST DI BAWAH -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        
        <!-- TEMPAT KHUSUS UNTUK HEADER STAGE -->
        <FrameLayout
            android:id="@+id/header_stage_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
            
        <!-- LIST USER (SCROLL DI BAWAH STAGE) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_user_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="90dp" /> 
            
    </LinearLayout>
        
</FrameLayout>